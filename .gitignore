# build/ is ignored above because it is derived from the ROM, but these three
# files are curated state, not build output: the claim table carries every
# status the integrator reconciled, triage carries the instruction-set map the
# verifier depends on, and the history file is the progress record. Losing them
# to a `git clean` would cost real work that cannot be regenerated.
# A negation cannot re-include a file whose parent directory is excluded, so
# the directories have to be walked back in one level at a time.
!build/
build/*
# Banked near-misses carry the diagnosis that stops the next person repeating
# ten attempts. loop_guard_notes.md is a worked negative result with a minimal
# reproducer; that is a deliverable, not build output.
!build/attempts/
!build/attempts/**
!build/reference/
build/reference/*
!build/reference/functions.json
!build/reference/triage.json
!build/reference/progress_history.jsonl

# ---------------------------------------------------------------------------
# ROM-derived content. Present locally, never committed.
#
# This is how pret-style decomps work: the repository holds source, and the
# game's own data is extracted from a ROM the user supplies. Shipping it would
# be redistributing Nintendo's assets, which is both the usual reason these
# projects get taken down and, at 189 MB, the reason this repo's history was
# 105 MB before these paths were stripped from it.
#
# Do not remove these lines to "fix" a build error -- nothing in the Makefile
# reads any of them.
files/
asm_dumps/
data/**/*.bin
IRBO.yml
tools/IRBO.yml

# Nintendo's SDK source and the CodeWarrior toolchain. lib/NitroSDK/ was
# already excluded; lib/TwlSystem/ (174 MB of NNS source) was NOT, and a bare
# `git add -A` would have committed 1,974 files of it. Both are proprietary and
# the user supplies them, exactly as with the ROM.
lib/
!lib/.gitkeep

# Built from tools/mwasmarm_patcher/mwasmarm_patcher.c by its own Makefile.
tools/mwasmarm_patcher/mwasmarm_patcher
tools/mwasmarm_patcher/mwasmarm_patcher.exe

# There are two blanket `*.py` rules in this file and the later one wins, so an
# earlier negation silently stops applying to NEW python files while tracked
# ones keep working -- which is how the toolchain went missing the first time.
# Keep this last.
!tools/scripts/*.py
